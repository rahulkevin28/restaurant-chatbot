# prod.env - do NOT commit this file to git. Replace placeholders before production.
DATABASE_URL=postgresql://postgres:REPLACE_DB_PASSWORD@db:5432/restaurant_db
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
CACHE_TTL=300
RATE_LIMIT=500/minute
PORT=8000
FLASK_ENV=production
FLASK_DEBUG=0
